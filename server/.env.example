# Copy to .env. Matches the database in ../docker-compose.yml (start it with
# `docker compose up -d` from the project root).
DATABASE_URL="postgresql://touchdown:touchdown_dev@localhost:5433/touchdown?schema=public"

# Optional
# PORT=3100   # must match SERVER_PORT in client/src/services/SocketService.ts
# MATCH_DURATION_SECONDS=60   # shorter matches for testing
# DEBUG_LOGS=false
